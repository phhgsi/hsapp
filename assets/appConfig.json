        {
          "regex": "https?://([-\\w]+\\.)*linkedin\\.com/.*",
          "mode": "appbrowser",
          "label": "LinkedIn",
          "pagesToTrigger": "custom"
        },
        {
          "regex": "https?://login\\.microsoftonline\\.com.*",
          "mode": "internal",
          "label": "Microsoft Login",
          "pagesToTrigger": "custom"
        },
        {
          "regex": "https?:\\/\\/([-\\w]+\\.)*educationportal3.in(\\/.*)?$",
          "mode": "internal",
          "label": "All pages on my domain",
          "pagesToTrigger": "domain"
        },
        {
          "regex": "https?:\\/\\/([-\\w]+\\.)*educationportal3\\.mp\\.gov\\.in(\\/.*)?$",
          "mode": "internal",
          "label": "All pages on mp.gov.in domain",
          "pagesToTrigger": "domain"
        },
        {
          "regex": ".*",
